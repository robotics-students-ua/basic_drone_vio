<!--
Visual scene for the quad. MuJoCo is used only for rendering: the drone is a mocap body
whose pose is copied from our own dynamics (quad.py) every step.
MuJoCo world is z-up (x forward, y left); sim_mujoco.py converts from NED.
The chessboard is added procedurally in sim_mujoco.py.
-->
<mujoco model="quad_scene">
  <visual>
    <global offwidth="640" offheight="480"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0 0 0"/>
    <quality shadowsize="0"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.35 0.38 0.35" rgb2="0.30 0.33 0.30"/>
    <material name="ground" texture="grid" texrepeat="20 20" reflectance="0"/>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.6 0.8 1.0" rgb2="0.2 0.3 0.5"
             width="256" height="256"/>
  </asset>

  <worldbody>
    <light pos="0 0 20" dir="0 0 -1" directional="true" castshadow="false"/>
    <geom name="ground" type="plane" size="50 50 0.1" material="ground"/>

    <body name="quad" mocap="true">
      <geom type="box" size="0.05 0.05 0.02" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="-0.07 -0.07 0  0.07  0.07 0" size="0.008" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="-0.07  0.07 0  0.07 -0.07 0" size="0.008" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos=" 0.07  0.07 0.01" size="0.04 0.003" rgba="0.9 0.2 0.2 0.6" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos=" 0.07 -0.07 0.01" size="0.04 0.003" rgba="0.9 0.2 0.2 0.6" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="-0.07  0.07 0.01" size="0.04 0.003" rgba="0.2 0.2 0.9 0.6" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="-0.07 -0.07 0.01" size="0.04 0.003" rgba="0.2 0.2 0.9 0.6" contype="0" conaffinity="0"/>
      <!-- downward camera, image "up" = drone forward. fovy 46.83 deg = 60 deg horizontal at 640x480,
           matching ChessboardPoseEstimator(fov_deg=60) -->
      <camera name="down_cam" pos="0 0 -0.03" xyaxes="0 -1 0 1 0 0" fovy="46.83"/>
      <!-- forward camera, looks along drone +x, image "up" = drone up -->
      <camera name="front_cam" pos="0.06 0 0" xyaxes="0 -1 0 0 0 1" fovy="46.83"/>
    </body>
  </worldbody>
</mujoco>
